# ==============================================================================
# MoSPI Real-time Airfare Price Index (APIx) - Environment Configuration
# SIH 2026 Problem Statement: SIH26056
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Database Settings
# ------------------------------------------------------------------------------
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=apix_mospi
USE_MONGODB=true

# ------------------------------------------------------------------------------
# 2. Automated Scraper Scheduler (APScheduler - Approach 1)
# ------------------------------------------------------------------------------
# Frequency in minutes for automatic flight scraping across all airlines/OTAs
# Default: 30 minutes
SCHEDULER_INTERVAL_MINUTES=30
SCHEDULER_INTERVAL_HOURS=0.5

# ------------------------------------------------------------------------------
# 3. Relational Database / Mirror (SQLite / PostgreSQL)
# ------------------------------------------------------------------------------
# SQLite Default: sqlite:///data/apix_mospi.db
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/apix_mospi
DATABASE_URL=sqlite:///data/apix_mospi.db

# ------------------------------------------------------------------------------
# 4. Statistical Index & Outlier Parameters (MoSPI Standard)
# ------------------------------------------------------------------------------
BASE_INDEX_VALUE=100.0
BASE_PERIOD_LABEL=2024-Q1
IQR_MULTIPLIER=1.5

# ------------------------------------------------------------------------------
# 5. API Server Metadata
# ------------------------------------------------------------------------------
PROJECT_NAME="MoSPI Real-time Airfare Price Index (APIx)"
VERSION="1.0.0"
API_V1_STR="/api/v1"
