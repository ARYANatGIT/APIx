{
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.git": true,
    "**/node_modules/**": true,
    "**/data/**": true,
    "**/scrapers/**/flight_results*": true,
    "**/scrapers/**/airline_*": true,
    "**/scrapers/**/captured_*": true,
    "**/__pycache__/**": true
  },
  "git.enabled": false,
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.showInlineNotification": false,
  "git.untrackedChanges": "separate",
  "git.decorations.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "terminal.integrated.env.windows": {
    "GIT_OPTIONAL_LOCKS": "0"
  }
}

